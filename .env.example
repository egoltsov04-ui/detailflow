VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only variables for Vercel. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SENDPULSE_API_KEY=your-static-sendpulse-api-key
# On the SMTP Test plan use devtest@sendpulseemail.com. Replace it with your verified sender in production.
SENDPULSE_API_FROM_EMAIL=devtest@sendpulseemail.com
SENDPULSE_API_FROM_NAME=Detailflow
SENDPULSE_API_BASE_URL=https://api.sendpulse.com
CRON_SECRET=create-a-long-random-secret

# WayForPay billing. Keep only the secret key as Secret in Vercel.
WAYFORPAY_MERCHANT_ACCOUNT=your-merchant-account
WAYFORPAY_SECRET_KEY=your-wayforpay-secret-key
WAYFORPAY_MERCHANT_DOMAIN=detailflow-xi.vercel.app
WAYFORPAY_APP_URL=https://detailflow-xi.vercel.app
