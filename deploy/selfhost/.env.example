# Copy to deploy/selfhost/.env on the server. Never commit the real file. Generate new secrets for every stack.
# Supabase: from the self-hosted stack's own .env (ANON_KEY, SERVICE_ROLE_KEY).
# Inside Docker the API reaches the gateway by container name; the browser uses the public URL baked into dist/.
VITE_SUPABASE_URL=http://supabase-envoy:8000
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Same value as detailflow_cron_secret in Vault (openssl rand -hex 24)
CRON_SECRET=
APP_URL=https://app.example.com
# staging on the staging stack, empty on production
DEPLOYMENT_ENV=staging
BILLING_MODE=manual
SENDPULSE_API_KEY=
SENDPULSE_API_FROM_EMAIL=
SENDPULSE_API_FROM_NAME=Detailflow
SENDPULSE_API_BASE_URL=https://api.sendpulse.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Only if BILLING_MODE=wayforpay
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_DOMAIN=
WAYFORPAY_SECRET_KEY=
# Caddy sites: real domains get HTTPS automatically
APP_SITE=app.example.com
SUPABASE_SITE=api.example.com
