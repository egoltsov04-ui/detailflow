# Detailflow behind Caddy: the built frontend, /api/* on the Node server, the Supabase gateway on its own host.
# Mirrors vercel.json (headers, redirects, SPA rewrites). Sites come from the environment, e.g.
# APP_SITE=app.example.com SUPABASE_SITE=api.example.com; locally :80 and :8001 over plain HTTP.
{$APP_SITE::80} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
	header /sw.js {
		Cache-Control no-cache
		Service-Worker-Allowed /
	}

	# Old addresses, kept from vercel.json
	redir /overview /app/overview 307
	redir /calendar /app/work/calendar 307
	redir /orders /app/work/kanban 307
	redir /work-orders /app/work/kanban 307
	redir /clients /app/clients 307
	redir /leads /app/clients/requests 307
	redir /media /app/clients/media 307
	redir /finance /app/finance/payments 307
	redir /payments /app/finance/payments 307
	redir /expenses /app/finance/expenses 307
	redir /sales /app/finance/sales 307
	redir /invoices /app/finance/invoices 307
	redir /receipts /app/finance/documents 307
	redir /team /app/team 307
	redir /tasks /app/team/tasks 307
	redir /warehouse /app/warehouse 307
	redir /inventory /app/warehouse 307
	redir /analytics /app/analytics 307
	redir /reports /app/analytics 307
	redir /settings /app/settings 307
	redir /services /app/settings/services 307
	redir /billing /app/settings/billing 307
	redir /booking-requests /app/work/requests 307
	redir /app/calendar /app/work/calendar 307
	redir /app/orders /app/work/kanban 307
	redir /app/work-orders /app/work/kanban 307
	redir /app/leads /app/clients/requests 307
	redir /app/media /app/clients/media 307
	redir /app/finance /app/finance/payments 307
	redir /app/payments /app/finance/payments 307
	redir /app/expenses /app/finance/expenses 307
	redir /app/sales /app/finance/sales 307
	redir /app/invoices /app/finance/invoices 307
	redir /app/receipts /app/finance/documents 307
	redir /app/tasks /app/team/tasks 307
	redir /app/inventory /app/warehouse 307
	redir /app/reports /app/analytics 307
	redir /app/services /app/settings/services 307
	redir /app/billing /app/settings/billing 307
	redir /app/booking-requests /app/work/requests 307
	redir /app/work/list /app/work/kanban 307

	handle /api/* {
		# Caddy replaces any X-Forwarded-For the client sent; the booking rate limit relies on it.
		reverse_proxy api:3000
	}
	handle {
		root * /srv
		@spa path /login /register /app /app/* /admin /admin/*
		rewrite @spa /index.html
		file_server
	}
}

{$SUPABASE_SITE::8001} {
	reverse_proxy {$SUPABASE_GATEWAY:supabase-envoy:8000}
}
