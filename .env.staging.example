# Copy to a private staging environment store; never put real secrets in Git.
# These must point to a dedicated staging Supabase project, never production.
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY

# Canonical public origin for this deployment (used by server-generated auth links).
APP_URL=https://staging.example.invalid

# Isolate email and money integrations in staging.
SENDPULSE_API_KEY=
SENDPULSE_API_FROM_EMAIL=
SENDPULSE_API_FROM_NAME=Detailflow Staging
SENDPULSE_API_BASE_URL=https://api.sendpulse.com
CRON_SECRET=GENERATE_A_UNIQUE_STAGING_SECRET
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.invalid
VITE_BILLING_MODE=manual
VITE_BILLING_TELEGRAM=
